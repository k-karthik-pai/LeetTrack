NODE_ENV=production
HOST=0.0.0.0
# Set this to the actual HTTPS URL from your hosting provider.
APP_URL=https://your-app.onrender.com
# Required: private authenticated Atlas URI, including /leettrack database name.
MONGODB_URI=
# Required: a randomly generated private session signing secret.
SESSION_SECRET=
COLLEGE_NAME=RV College of Engineering
COLLEGE_EMAIL_DOMAIN=rvce.edu.in
# Optional Google login; callback is APP_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SYNC_INTERVAL_MINUTES=60
SYNC_COOLDOWN_SECONDS=300
MONGOMS_DISABLE_POSTINSTALL=1
