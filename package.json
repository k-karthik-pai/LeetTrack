{
  "name": "leettrack",
  "version": "1.0.0",
  "private": true,
  "description": "A college LeetCode community built with React, Vite, Express and MongoDB.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "admin": "node scripts/admin.js",
    "verify:leetcode": "node scripts/verify-leetcode.js",
    "build": "vite build",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "preview:react": "node scripts/preview-react.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.63.0",
    "mongodb-memory-server": "^10.3.0",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vite": "^8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
