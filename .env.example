PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
# Blank starts a REAL local MongoDB with persistent .data/mongo storage.
# First start downloads a MongoDB binary. Atlas/local MongoDB can be used instead.
MONGODB_URI=
SESSION_SECRET=
COLLEGE_NAME=RV College of Engineering
# Restricts signup and Google sign-in to RVCE email addresses.
COLLEGE_EMAIL_DOMAIN=rvce.edu.in
# Register exactly APP_URL/api/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SYNC_INTERVAL_MINUTES=60
SYNC_COOLDOWN_SECONDS=300
